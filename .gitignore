# ============================================================
# git 只跟"会变的东西"：代码、方案、设计文档、审核记录。
# 冻结的存档与批量产物不跟 —— 它们没有版本历史价值。
# ============================================================

# 凭据 —— 绝不提交
.env
.env.*
!.env.example

# 上游仓库（802M，可重新 clone；AGENTS.md 硬规则 6：只读参考）
repos/

# 本地环境与依赖
.venv/
node_modules/

# Python 缓存
__pycache__/
*.pyc

# 可再生的构建产物
output/
workspace/

# ------------------------------------------------------------
# 外围存档：一次抓取/转录后即冻结，不会再变
#   raw/        官网抓取原文（README.md 是它的摘要）
#   class/      研习营转录稿（含大量 ASR 错误，引用前须核对）
#   screenshots/ 截图存档
#
# ⚠️ 注释必须独立成行 —— gitignore 不支持行尾注释，
#    「raw/   # 说明」会被整行当成模式，静默失效。
# ------------------------------------------------------------
raw/
class/
screenshots/

# ------------------------------------------------------------
# runs/：只跟 RunRecord（.json，小、被方案与 docs 引用，且含 git_commit 链接）
# 原始日志与逐次用量（.log / .jsonl / .txt / .out）不跟 —— 体量大、只增不减
# ------------------------------------------------------------
runs/*
!runs/README.md
!runs/*.json

# 工具状态，非项目内容
.gstack/

# ------------------------------------------------------------
# 2026-09-27 重写：旧工作区封存的**完整拷贝**（含旧 pipeline/eval/docs/runs/PLAN）。
# 它是"可查不可改"的只读存档，且与根目录下同名文件重复 → 不跟版本。
# 要看它：本地目录就在，或按 PHASE-NOTE-g2.md 里的 git 历史回溯。
# ------------------------------------------------------------
legacy/

# g2 的产物与实验工作区（可再生产物）
g2/work/
g2/runs/
g2/packs/*/tests/

# ------------------------------------------------------------
# 平台材料与临时文件
#   sublog/：平台**官方需求原件**（含 reference 截图）与运行日志。
#   仓库是公开的 → 别人的赛题材料不该由我们发布；留本地即可。
#   package-lock.json：根目录下误生成的 npm 残留。
# ------------------------------------------------------------
sublog/
package-lock.json
